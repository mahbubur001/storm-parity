{
  "commands": [
    { "command": "stormParity.shelf.shelve", "title": "Shelve Changes...", "category": "Storm", "icon": "$(archive)" },
    { "command": "stormParity.shelf.shelveChangelist", "title": "Shelve Changelist...", "category": "Storm", "icon": "$(archive)" },
    { "command": "stormParity.shelf.shelveFiles", "title": "Shelve Files...", "category": "Storm", "icon": "$(archive)" },
    { "command": "stormParity.shelf.unshelve", "title": "Unshelve...", "category": "Storm", "icon": "$(debug-step-out)" },
    { "command": "stormParity.shelf.unshelveSilently", "title": "Unshelve Silently", "category": "Storm" },
    { "command": "stormParity.shelf.delete", "title": "Delete Shelved Changes", "category": "Storm", "icon": "$(trash)" },
    { "command": "stormParity.shelf.showPatch", "title": "Show Shelved Patch", "category": "Storm", "icon": "$(diff)" },
    { "command": "stormParity.shelf.rename", "title": "Rename Shelved Changes...", "category": "Storm" },
    { "command": "stormParity.shelf.refresh", "title": "Refresh Shelf", "category": "Storm", "icon": "$(refresh)" }
  ],
  "views": {
    "stormParity": [
      { "id": "stormParity.shelf", "name": "Shelf", "icon": "$(archive)", "contextualTitle": "Storm" }
    ]
  },
  "viewsWelcome": [
    {
      "view": "stormParity.shelf",
      "contents": "No shelved changes for the open repositories.\n[Shelve Changes...](command:stormParity.shelf.shelve)"
    }
  ],
  "menus": {
    "commandPalette": [
      { "command": "stormParity.shelf.shelveChangelist", "when": "false" },
      { "command": "stormParity.shelf.shelveFiles", "when": "false" },
      { "command": "stormParity.shelf.refresh", "when": "false" }
    ],
    "view/title": [
      { "command": "stormParity.shelf.shelve", "group": "navigation@1", "when": "view == stormParity.shelf" },
      { "command": "stormParity.shelf.refresh", "group": "navigation@2", "when": "view == stormParity.shelf" }
    ],
    "view/item/context": [
      { "command": "stormParity.shelf.unshelve", "group": "inline@1", "when": "view == stormParity.shelf && viewItem == shelf" },
      { "command": "stormParity.shelf.showPatch", "group": "inline@2", "when": "view == stormParity.shelf && viewItem == shelf" },
      { "command": "stormParity.shelf.unshelve", "group": "1_apply@1", "when": "view == stormParity.shelf && viewItem == shelf" },
      { "command": "stormParity.shelf.unshelveSilently", "group": "1_apply@2", "when": "view == stormParity.shelf && viewItem == shelf" },
      { "command": "stormParity.shelf.showPatch", "group": "2_view@1", "when": "view == stormParity.shelf && viewItem =~ /^shelf/" },
      { "command": "stormParity.shelf.rename", "group": "3_edit@1", "when": "view == stormParity.shelf && viewItem == shelf" },
      { "command": "stormParity.shelf.delete", "group": "3_edit@2", "when": "view == stormParity.shelf && viewItem == shelf" }
    ],
    "scm/resourceGroup/context": [
      { "command": "stormParity.shelf.shelveChangelist", "group": "3_shelf@1", "when": "scmProvider == stormParity.changelists" }
    ],
    "scm/resourceState/context": [
      { "command": "stormParity.shelf.shelveFiles", "group": "3_shelf@1", "when": "scmProvider == stormParity.changelists || scmProvider == git" }
    ],
    "scm/title": [
      { "command": "stormParity.shelf.shelve", "group": "2_shelf@1", "when": "scmProvider == stormParity.changelists" }
    ]
  },
  "configuration": {
    "title": "Shelf",
    "properties": {
      "stormParity.shelf.removeAfterUnshelve": {
        "type": "boolean",
        "default": true,
        "description": "Remove a shelf entry after it was unshelved without conflicts (default choice in Unshelve, always used by Unshelve Silently)."
      }
    }
  }
}
