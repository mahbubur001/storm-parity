{
  "commands": [
    { "command": "stormParity.copyReference.copyReference", "title": "Copy Reference", "category": "Storm" },
    { "command": "stormParity.copyReference.copyReferenceAs", "title": "Copy Reference As...", "category": "Storm" }
  ],
  "keybindings": [
    {
      "command": "stormParity.copyReference.copyReference",
      "mac": "cmd+alt+shift+c",
