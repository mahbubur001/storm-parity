    }
  ],
  "menus": {
    "editor/context": [
      { "command": "stormParity.copyReference.copyReference", "group": "9_cutcopypaste@10" },
      { "command": "stormParity.copyReference.copyReferenceAs", "group": "9_cutcopypaste@11" }
    ],
    "commandPalette": [
      { "command": "stormParity.copyReference.copyReference", "when": "editorIsOpen" },
      { "command": "stormParity.copyReference.copyReferenceAs", "when": "editorIsOpen" }
    ]
  }
}
