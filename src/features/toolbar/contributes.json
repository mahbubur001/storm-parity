{
  "commands": [
    { "command": "stormParity.toolbar.checkout", "title": "Checkout Branch...", "category": "Storm", "icon": "$(git-branch)" }
  ],
  "menus": {
    "commandPalette": [
      { "command": "stormParity.toolbar.checkout", "when": "false" }
    ],
    "editor/title": [
      {
        "command": "stormParity.openFolder.openRecent",
        "group": "navigation@1",
        "when": "config.stormParity.toolbar.enabled && config.workbench.editor.editorActionsLocation == titleBar && config.stormParity.toolbar.showProject && config.stormParity.openFolder.enabled"
      },
      {
        "command": "stormParity.toolbar.checkout",
        "group": "navigation@2",
        "when": "config.stormParity.toolbar.enabled && config.workbench.editor.editorActionsLocation == titleBar && config.stormParity.toolbar.showBranch && gitOpenRepositoryCount != 0"
      },
      {
        "command": "stormParity.changelists.commitActive",
        "group": "navigation@3",
        "when": "config.stormParity.toolbar.enabled && config.workbench.editor.editorActionsLocation == titleBar && config.stormParity.toolbar.showCommit && config.stormParity.changelists.enabled"
      },
      {
        "command": "stormParity.run.run",
        "group": "navigation@4",
        "when": "config.stormParity.toolbar.enabled && config.workbench.editor.editorActionsLocation == titleBar && config.stormParity.toolbar.showRun && config.stormParity.run.enabled"
      },
      {
        "command": "stormParity.run.debug",
        "group": "navigation@5",
        "when": "config.stormParity.toolbar.enabled && config.workbench.editor.editorActionsLocation == titleBar && config.stormParity.toolbar.showRun && config.stormParity.run.enabled"
      },
      {
        "command": "stormParity.run.stop",
        "group": "navigation@6",
        "when": "config.stormParity.toolbar.enabled && config.workbench.editor.editorActionsLocation == titleBar && config.stormParity.toolbar.showRun && config.stormParity.run.enabled && stormParity.run.running"
      },
      {
        "command": "stormParity.searchEverywhere.open",
        "group": "navigation@7",
        "when": "config.stormParity.toolbar.enabled && config.workbench.editor.editorActionsLocation == titleBar && config.stormParity.toolbar.showSearch && config.stormParity.searchEverywhere.enabled"
      }
    ]
  },
  "configuration": {
    "title": "Title Bar Toolbar",
    "properties": {
      "stormParity.toolbar.showStatusBarProject": {
        "type": "boolean",
        "default": true,
        "order": 0,
        "description": "Project name and current branch at the far left of the status bar, like PhpStorm's top-left project and branch widgets (VS Code centres the window title and has no left-hand title bar slot)."
      },
      "stormParity.toolbar.showProject": {
        "type": "boolean",
        "default": true,
        "order": 1,
        "description": "Recent Projects button, like PhpStorm's project widget."
      },
      "stormParity.toolbar.showBranch": {
        "type": "boolean",
        "default": true,
        "order": 2,
        "description": "Checkout Branch button, like PhpStorm's branch widget."
      },
      "stormParity.toolbar.showCommit": {
        "type": "boolean",
        "default": true,
        "order": 3,
        "description": "Commit Active Changelist button."
      },
      "stormParity.toolbar.showRun": {
        "type": "boolean",
        "default": true,
        "order": 4,
        "description": "Run, Debug and Stop buttons for the selected run configuration."
      },
      "stormParity.toolbar.showSearch": {
        "type": "boolean",
        "default": true,
        "order": 5,
        "description": "Search Everywhere button."
      }
    }
  }
}
