{
  "commands": [
    {
      "command": "stormParity.bookmarks.toggle",
      "title": "Toggle Bookmark",
      "category": "Storm"
    },
    {
      "command": "stormParity.bookmarks.toggleMnemonic",
      "title": "Toggle Bookmark with Mnemonic...",
      "category": "Storm"
    },
    {
      "command": "stormParity.bookmarks.toggleNumeric",
      "title": "Toggle Numeric Mnemonic Bookmark...",
      "category": "Storm"
    },
    {
      "command": "stormParity.bookmarks.jumpToMnemonic",
      "title": "Go to Mnemonic Bookmark...",
      "category": "Storm"
    },
    {
      "command": "stormParity.bookmarks.showAll",
      "title": "Show All Bookmarks",
      "category": "Storm",
      "icon": "$(list-flat)"
    },
    {
      "command": "stormParity.bookmarks.next",
      "title": "Next Bookmark in File",
      "category": "Storm"
    },
    {
      "command": "stormParity.bookmarks.previous",
      "title": "Previous Bookmark in File",
      "category": "Storm"
    },
    {
      "command": "stormParity.bookmarks.editDescription",
      "title": "Edit Bookmark Description...",
      "category": "Storm",
      "icon": "$(edit)"
    },
    {
      "command": "stormParity.bookmarks.delete",
      "title": "Delete Bookmark",
      "category": "Storm",
      "icon": "$(trash)"
    },
    {
      "command": "stormParity.bookmarks.clearAll",
      "title": "Delete All Bookmarks",
      "category": "Storm",
      "icon": "$(clear-all)"
    },
    {
      "command": "stormParity.bookmarks.reveal",
      "title": "Reveal Bookmark",
      "category": "Storm"
    }
  ],
  "keybindings": [
    {
      "command": "stormParity.bookmarks.toggle",
      "key": "f11",
      "mac": "f3",
      "when": "editorTextFocus"
    },
    {
      "command": "stormParity.bookmarks.toggleMnemonic",
      "key": "ctrl+f11",
      "mac": "alt+f3",
      "when": "editorTextFocus"
    },
    {
      "command": "stormParity.bookmarks.showAll",
      "key": "shift+f11",
      "mac": "cmd+f3"
    },
    {
      "command": "stormParity.bookmarks.jumpToMnemonic",
      "key": "ctrl+0",
      "mac": "ctrl+0",
      "args": "0"
    },
    {
      "command": "stormParity.bookmarks.jumpToMnemonic",
      "key": "ctrl+1",
      "mac": "ctrl+1",
      "args": "1"
    },
    {
      "command": "stormParity.bookmarks.jumpToMnemonic",
      "key": "ctrl+2",
      "mac": "ctrl+2",
      "args": "2"
    },
    {
      "command": "stormParity.bookmarks.jumpToMnemonic",
      "key": "ctrl+3",
      "mac": "ctrl+3",
      "args": "3"
    },
    {
      "command": "stormParity.bookmarks.jumpToMnemonic",
      "key": "ctrl+4",
      "mac": "ctrl+4",
      "args": "4"
    },
    {
      "command": "stormParity.bookmarks.jumpToMnemonic",
      "key": "ctrl+5",
      "mac": "ctrl+5",
      "args": "5"
    },
    {
      "command": "stormParity.bookmarks.jumpToMnemonic",
      "key": "ctrl+6",
      "mac": "ctrl+6",
      "args": "6"
    },
    {
      "command": "stormParity.bookmarks.jumpToMnemonic",
      "key": "ctrl+7",
      "mac": "ctrl+7",
      "args": "7"
    },
    {
      "command": "stormParity.bookmarks.jumpToMnemonic",
      "key": "ctrl+8",
      "mac": "ctrl+8",
      "args": "8"
    },
    {
      "command": "stormParity.bookmarks.jumpToMnemonic",
      "key": "ctrl+9",
      "mac": "ctrl+9",
      "args": "9"
    },
    {
      "command": "stormParity.bookmarks.toggleNumeric",
      "key": "ctrl+shift+0",
      "mac": "ctrl+shift+0",
      "args": "0",
      "when": "editorTextFocus"
    },
    {
      "command": "stormParity.bookmarks.toggleNumeric",
      "key": "ctrl+shift+1",
      "mac": "ctrl+shift+1",
      "args": "1",
      "when": "editorTextFocus"
    },
    {
      "command": "stormParity.bookmarks.toggleNumeric",
      "key": "ctrl+shift+2",
      "mac": "ctrl+shift+2",
      "args": "2",
      "when": "editorTextFocus"
    },
    {
      "command": "stormParity.bookmarks.toggleNumeric",
      "key": "ctrl+shift+3",
      "mac": "ctrl+shift+3",
      "args": "3",
      "when": "editorTextFocus"
    },
    {
      "command": "stormParity.bookmarks.toggleNumeric",
      "key": "ctrl+shift+4",
      "mac": "ctrl+shift+4",
      "args": "4",
      "when": "editorTextFocus"
    },
    {
      "command": "stormParity.bookmarks.toggleNumeric",
      "key": "ctrl+shift+5",
      "mac": "ctrl+shift+5",
      "args": "5",
      "when": "editorTextFocus"
    },
    {
      "command": "stormParity.bookmarks.toggleNumeric",
      "key": "ctrl+shift+6",
      "mac": "ctrl+shift+6",
      "args": "6",
      "when": "editorTextFocus"
    },
    {
      "command": "stormParity.bookmarks.toggleNumeric",
      "key": "ctrl+shift+7",
      "mac": "ctrl+shift+7",
      "args": "7",
      "when": "editorTextFocus"
    },
    {
      "command": "stormParity.bookmarks.toggleNumeric",
      "key": "ctrl+shift+8",
      "mac": "ctrl+shift+8",
      "args": "8",
      "when": "editorTextFocus"
    },
    {
      "command": "stormParity.bookmarks.toggleNumeric",
      "key": "ctrl+shift+9",
      "mac": "ctrl+shift+9",
      "args": "9",
      "when": "editorTextFocus"
    }
  ],
  "menus": {
    "commandPalette": [
      {
        "command": "stormParity.bookmarks.reveal",
        "when": "false"
      },
      {
        "command": "stormParity.bookmarks.toggle",
        "when": "editorIsOpen"
      },
      {
        "command": "stormParity.bookmarks.toggleMnemonic",
        "when": "editorIsOpen"
      },
      {
        "command": "stormParity.bookmarks.toggleNumeric",
        "when": "editorIsOpen"
      },
      {
        "command": "stormParity.bookmarks.next",
        "when": "editorIsOpen"
      },
      {
        "command": "stormParity.bookmarks.previous",
        "when": "editorIsOpen"
      }
    ],
    "view/title": [
      {
        "command": "stormParity.bookmarks.showAll",
        "when": "view == stormParity.bookmarks",
        "group": "navigation@1"
      },
      {
        "command": "stormParity.bookmarks.clearAll",
        "when": "view == stormParity.bookmarks",
        "group": "navigation@2"
      }
    ],
    "view/item/context": [
      {
        "command": "stormParity.bookmarks.editDescription",
        "when": "view == stormParity.bookmarks && viewItem == stormParity.bookmark",
        "group": "inline@1"
      },
      {
        "command": "stormParity.bookmarks.delete",
        "when": "view == stormParity.bookmarks && viewItem =~ /^stormParity\\.bookmark/",
        "group": "inline@2"
      },
      {
        "command": "stormParity.bookmarks.editDescription",
        "when": "view == stormParity.bookmarks && viewItem == stormParity.bookmark",
        "group": "1_edit@1"
      },
      {
        "command": "stormParity.bookmarks.delete",
        "when": "view == stormParity.bookmarks && viewItem =~ /^stormParity\\.bookmark/",
        "group": "1_edit@2"
      }
    ]
  },
  "views": {
    "stormParity": [
      {
        "id": "stormParity.bookmarks",
        "name": "Bookmarks",
        "icon": "$(bookmark)"
      }
    ]
  },
  "colors": [
    {
      "id": "stormParity.bookmarks.overviewRuler",
      "description": "Overview ruler mark for Storm bookmarks.",
      "defaults": {
        "dark": "#3B82C4",
        "light": "#3B82C4",
        "highContrast": "#4FA3E8"
      }
    }
  ],
  "configuration": {
    "title": "Bookmarks",
    "properties": {}
  }
}
