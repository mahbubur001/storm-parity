{
  "name": "storm-parity",
  "displayName": "Storm Parity",
  "description": "PhpStorm workflow features for VS Code.",
  "version": "0.0.1",
  "publisher": "mahbubur",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "local"
  },
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "stormParity.hello.sayHello",
        "title": "Say Hello",
        "category": "Storm"
      }
    ],
    "configuration": {
      "title": "Storm Parity",
      "properties": {
        "stormParity.hello.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Hello feature (scaffold smoke test)."
        }
      }
    }
  },
  "scripts": {
    "build": "bun run typecheck && node esbuild.mjs --production",
    "build:dev": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "bun run build && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "install:local": "code --install-extension storm-parity-$(node -p \"require('./package.json').version\").vsix --force",
    "pretest": "bun run typecheck && node esbuild.mjs --tests",
    "test": "vscode-test",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "1.145.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  }
}
